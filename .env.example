# Generate a strong secret for every environment. Do not commit your real .env.
SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Local Docker Compose database. For bare-metal development, omit DATABASE_URL
# and Django will use SQLite automatically.
POSTGRES_DB=opstrace
POSTGRES_USER=opstrace
POSTGRES_PASSWORD=replace-this-db-password
DATABASE_URL=postgres://opstrace:replace-this-db-password@db:5432/opstrace

# Security / reverse proxy settings
SECURE_SSL_REDIRECT=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_HSTS_SECONDS=0

# Email defaults to console output. Configure SMTP for real invitations/notifications.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=OpsTrace <noreply@example.com>
LOG_LEVEL=INFO
WEB_CONCURRENCY=3
